{
  "name": "valid-coding-new-task-verified",
  "description": "Task 4 (ADR-025 (fork)): coding/new-task-v1 plus an advisory review_and_fix step.",
  "workflow": {
    "id": "coding/new-task-verified-v1",
    "version": "1.0.0",
    "domain": "coding",
    "description": "Implement a GitHub issue, get an independent advisory review, and open a pull request.",
    "requires_repo": true,
    "read_only": false,
    "prompt": {
      "template": "registry://prompt/coding-new-task-workflow"
    },
    "hydration": {
      "sources": [
        "issue",
        "memory",
        "task_description"
      ]
    },
    "agent_config": {
      "tier": "standard",
      "allowed_tools": [
        "Bash",
        "Read",
        "Write",
        "Edit",
        "Glob",
        "Grep",
        "WebFetch"
      ],
      "cedar_policy_modules": [
        "builtin/hard_deny",
        "builtin/soft_deny"
      ]
    },
    "repo_config": {
      "provider": "github",
      "discover": true
    },
    "required_inputs": {
      "one_of": [
        "issue_number",
        "task_description"
      ]
    },
    "steps": [
      {
        "kind": "clone_repo",
        "name": "setup"
      },
      {
        "kind": "hydrate_context",
        "name": "context"
      },
      {
        "kind": "run_agent",
        "name": "implement"
      },
      {
        "kind": "review_and_fix",
        "name": "review",
        "review_mode": "advisory"
      },
      {
        "kind": "verify_build",
        "name": "build",
        "gate": "regression_only"
      },
      {
        "kind": "ensure_pr",
        "name": "open_pr",
        "strategy": "create"
      }
    ],
    "terminal_outcomes": {
      "primary": "pr_url"
    },
    "convergence": {
      "mode": "test_gated",
      "required_sensors": [
        "verify_build"
      ],
      "terminal_outcomes": [
        "pr_opened"
      ]
    },
    "limits": {
      "max_turns": 100
    },
    "promotion_gate": {
      "requires": [
        "tests:agent/review_and_fix"
      ]
    },
    "status": "production"
  },
  "expected": {
    "valid": true,
    "violations": []
  }
}
